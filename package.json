{
  "name": "impulse",
  "productName": "Impulse",
  "private": true,
  "version": "0.1.0",
  "description": "AI trading terminal for Hyperliquid",
  "author": "Impulse",
  "homepage": "https://github.com/joshjkns/impulse",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.ts",
  "scripts": {
    "dev": "concurrently -k -n web,bridge -c gray,blue \"vite\" \"node --watch-path=bridge bridge/server.ts\"",
    "app": "pnpm build && electron .",
    "app:dev": "concurrently -k -n web,app -c gray,magenta \"vite\" \"wait-on http://localhost:5173 && electron . --dev-url=http://localhost:5173\"",
    "web": "vite",
    "bridge": "node bridge/server.ts",
    "build": "tsc -b && vite build",
    "dist": "pnpm build && electron-builder",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:linux": "pnpm build && electron-builder --linux",
    "typecheck": "tsc -b && tsc -p bridge && tsc -p electron",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nktkas/hyperliquid": "^0.33.3",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "concurrently": "^10.0.6",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.57.0",
    "motion": "^14.3.0",
    "next-themes": "^0.4.6",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.1",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-grid-layout": "^2.3.0",
    "react-resizable-panels": "4.14.5",
    "react-router": "^8.4.0",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "viem": "^2.57.7",
    "vite": "^8.3.0",
    "wagmi": "^2.19.5",
    "wait-on": "^9.5.1",
    "zustand": "^5.0.15"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "build": {
    "appId": "app.impulse.terminal",
    "productName": "Impulse",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      "package.json",
      "electron/**",
      "bridge/**",
      "dist/**",
      "src/lib/catalog.ts",
      "!**/tsconfig.json"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Finance",
      "maintainer": "joshjkns <joshjkns@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
